.env
.env.*
node_modules/
__pycache__/
.venv/
dist/
.DS_Store
# Camera pictures stay out of the public repo; the demo page loads its own consented set.
pictures/
*.jpg
*.jpeg
*.png
*.mp4
*.db
# The demo's own clips, pictures and alerts are public (MEVA, CC BY 4.0), so a clone runs on its own.
!demo-data/**
demo-data/limits.json
demo-data/clips/*/frames/
demo-data/events.db
demo-data/telegram.db
