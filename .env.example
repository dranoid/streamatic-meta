# Copy this file to .env. The demo runs with nothing set: the clips, their rules and alerts work, and no model is called.

# Searching and tracking anything new, planning a rule, a voice note, your own picture.
META_MODEL_API_KEY=
BASETEN_API_KEY=

# Alerts on Telegram: a bot of your own, from Telegram's BotFather.
# DEMO_TELEGRAM_TOKEN=
# The page's address, which the bot gives to someone who finds it on their own.
# DEMO_PAGE_URL=

# Questions about a clip with no recorded tracks: a detector of your own on Modal.
# DETECT_URL=
# DETECT_SECRET=

# The public page's daily ceiling on model spending, in US dollars.
# DEMO_CEILING_USD=10

# Reading a new rule over a clip, and saving rules: Streamatic's backend, which is not public.
# STREAMATIC_API=
# STREAMATIC_COMPANY=
# STREAMATIC_EMAIL=
# STREAMATIC_PASSWORD=

# The app without the public limits sends its own alerts to this chat, on the same bot.
# TELEGRAM_CHAT_ID=
# pidgin or yoruba; English if not set.
# TELEGRAM_ALERT_LANGUAGE=
